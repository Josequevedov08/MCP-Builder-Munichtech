# Featherless.ai (leave the key empty to use the built-in template generator)
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=zai-org/GLM-5.2
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MAX_TOKENS=1024
FEATHERLESS_TIMEOUT=60
FEATHERLESS_THINKING=false
FEATHERLESS_MOCK=false

# ElevenLabs (leave the key empty to disable voice status audio)
ELEVENLABS_API_KEY=
# Optional backup key, used only if the main key is out of credits or rejected
ELEVENLABS_API_KEY_2=
ELEVENLABS_VOICE_ID=Xb7hH8MSUJpSbSDYk0k2

# Receipt emails. Set MAIL_FROM and either RESEND_API_KEY (HTTPS API, works where SMTP is blocked) or SMTP_HOST.
# Leave both empty to disable them.
RESEND_API_KEY=
# Resend: SMTP_HOST=smtp.resend.com, SMTP_USER=resend, SMTP_PASSWORD=<your API key>
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_USER=<address>, SMTP_PASSWORD=<app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000
SERVE_SITE=true
RATE_LIMIT_BUILDS_PER_MINUTE=5
RATE_LIMIT_VOICE_PER_MINUTE=20
MAX_CONCURRENT_BUILDS=3
RATE_LIMIT_RECEIPTS_PER_MINUTE=3
HOST=127.0.0.1
PORT=8000
